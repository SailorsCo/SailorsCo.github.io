```html
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Islamic Prayer Times</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #1e3c72, #2a5298);
      color: white;
      text-align: center;
      margin: 0;
      padding: 20px;
      min-height: 100vh;
    }

    h1 {
      margin-bottom: 10px;
    }

    #location {
      font-size: 20px;
      margin-bottom: 8px;
    }

    #coordinates {
      font-size: 13px;
      opacity: 0.75;
      margin-bottom: 15px;
    }

    #datetime {
      font-size: 18px;
      margin-bottom: 20px;
    }

    .card {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 20px;
      margin: 10px auto;
      max-width: 400px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }

    .prayer {
      display: flex;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.2);
      font-size: 18px;
    }

    .prayer:last-child {
      border-bottom: none;
    }

    .prayer-name {
      font-weight: bold;
    }

    button {
      padding: 10px 20px;
      font-size: 16px;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      background: #ffcc00;
      color: black;
      margin-top: 15px;
    }

    button:hover {
      opacity: 0.9;
    }

    #message {
      margin-top: 20px;
      font-size: 22px;
      font-weight: bold;
    }

    #countdown {
      font-size: 20px;
      margin-top: 10px;
    }

    #status {
      margin-top: 15px;
      font-size: 15px;
      opacity: 0.9;
    }

    .loading {
      font-size: 18px;
    }

    .error {
      color: #ffdddd;
    }
  </style>
</head>

<body>

  <h1>🕌 Islamic Prayer Times</h1>

  <div id="location">
    📍 Detecting your location...
  </div>

  <div id="coordinates"></div>

  <div id="datetime"></div>

  <div class="card">
    <div id="times" class="loading">
      Loading prayer times...
    </div>
  </div>

  <div class="card">
    <div id="countdown">
      Calculating next prayer...
    </div>
  </div>

  <button onclick="requestNotificationPermission()">
    🔔 Enable Notifications
  </button>

  <div id="status"></div>

  <div id="message"></div>

  <audio id="audio" preload="auto"></audio>


  <script>

    /*
     * ==========================================
     * SETTINGS
     * ==========================================
     */

    // AlAdhan calculation method.
    // Method 2 = Islamic Society of North America (ISNA)
    const CALCULATION_METHOD = 2;

    // Prayer audio
    const PRAYER_AUDIO =
      "https://sailorsco.github.io/cdn/audio/Prayer5.m4a";


    /*
     * ==========================================
     * GLOBAL VARIABLES
     * ==========================================
     */

    let prayerTimes = {};

    let userLatitude = null;
    let userLongitude = null;

    let userCity = "Your Location";

    // Used to prevent the same prayer from triggering
    // multiple times during the same minute.
    let lastTriggeredPrayer = null;

    // Keep track of the date for refreshing prayer times.
    let currentDate = getDateString();


    /*
     * ==========================================
     * DATE
     * ==========================================
     */

    function getDateString() {
      const now = new Date();

      return (
        now.getFullYear() +
        "-" +
        String(now.getMonth() + 1).padStart(2, "0") +
        "-" +
        String(now.getDate()).padStart(2, "0")
      );
    }


    /*
     * ==========================================
     * CURRENT DATE & TIME
     * ==========================================
     */

    function updateDateTime() {

      const now = new Date();

      const date = now.toLocaleDateString(undefined, {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric"
      });

      const time = now.toLocaleTimeString();

      document.getElementById("datetime").innerText =
        `${date} | ${time}`;
    }


    /*
     * ==========================================
     * GET USER LOCATION
     * ==========================================
     */

    function getUserLocation() {

      if (!navigator.geolocation) {

        showError(
          "Your browser does not support location detection."
        );

        return;
      }

      document.getElementById("location").innerText =
        "📍 Requesting your location...";

      navigator.geolocation.getCurrentPosition(

        async function(position) {

          userLatitude = position.coords.latitude;
          userLongitude = position.coords.longitude;

          document.getElementById("coordinates").innerText =
            `Latitude: ${userLatitude.toFixed(4)} | Longitude: ${userLongitude.toFixed(4)}`;

          document.getElementById("location").innerText =
            "📍 Finding your city...";

          await findCity();

          await fetchPrayerTimes();

        },

        function(error) {

          console.error(error);

          showError(
            "Location permission was denied or your location could not be detected."
          );

          // Fallback location
          useFallbackLocation();
        },

        {
          enableHighAccuracy: true,
          timeout: 10000,
          maximumAge: 300000
        }

      );
    }


    /*
     * ==========================================
     * FALLBACK LOCATION
     * ==========================================
     *
     * If the user refuses location permission,
     * the website uses Holbæk as a fallback.
     */

    function useFallbackLocation() {

      userLatitude = 55.7167;
      userLongitude = 11.7167;

      userCity = "Holbæk, Denmark";

      document.getElementById("location").innerText =
        `📍 ${userCity} (fallback location)`;

      document.getElementById("coordinates").innerText =
        `Latitude: ${userLatitude} | Longitude: ${userLongitude}`;

      fetchPrayerTimes();
    }


    /*
     * ==========================================
     * FIND CITY FROM COORDINATES
     * ==========================================
     *
     * Uses OpenStreetMap's Nominatim service
     * to determine the city/town.
     */

    async function findCity() {

      try {

        const url =
          `https://nominatim.openstreetmap.org/reverse?format=json&lat=${userLatitude}&lon=${userLongitude}&zoom=10&addressdetails=1`;

        const response = await fetch(url, {
          headers: {
            "Accept": "application/json"
          }
        });

        const data = await response.json();

        const address = data.address || {};

        userCity =
          address.city ||
          address.town ||
          address.village ||
          address.municipality ||
          address.county ||
          "Your Location";

        const country =
          address.country || "";

        document.getElementById("location").innerText =
          `📍 ${userCity}${country ? ", " + country : ""}`;

      }

      catch (error) {

        console.error(
          "Could not determine city:",
          error
        );

        userCity = "Your Location";

        document.getElementById("location").innerText =
          "📍 Your Location";
      }
    }


    /*
     * ==========================================
     * GET PRAYER TIMES
     * ==========================================
     */

    async function fetchPrayerTimes() {

      try {

        document.getElementById("status").innerText =
          "Loading today's prayer times...";

        const url =
          `https://api.aladhan.com/v1/timings?latitude=${userLatitude}&longitude=${userLongitude}&method=${CALCULATION_METHOD}`;

        const response = await fetch(url);

        if (!response.ok) {
          throw new Error(
            "Prayer API request failed."
          );
        }

        const data = await response.json();

        if (!data.data || !data.data.timings) {
          throw new Error(
            "Invalid prayer time response."
          );
        }

        prayerTimes = data.data.timings;

        displayTimes();

        document.getElementById("status").innerText =
          "Prayer times updated.";

      }

      catch (error) {

        console.error(error);

        showError(
          "Unable to load prayer times."
        );
      }
    }


    /*
     * ==========================================
     * DISPLAY PRAYER TIMES
     * ==========================================
     */

    function displayTimes() {

      const container =
        document.getElementById("times");

      container.innerHTML = `

        <div class="prayer">
          <span class="prayer-name">Fajr</span>
          <span>${cleanTime(prayerTimes.Fajr)}</span>
        </div>

        <div class="prayer">
          <span class="prayer-name">Dhuhr</span>
          <span>${cleanTime(prayerTimes.Dhuhr)}</span>
        </div>

        <div class="prayer">
          <span class="prayer-name">Asr</span>
          <span>${cleanTime(prayerTimes.Asr)}</span>
        </div>

        <div class="prayer">
          <span class="prayer-name">Maghrib</span>
          <span>${cleanTime(prayerTimes.Maghrib)}</span>
        </div>

        <div class="prayer">
          <span class="prayer-name">Isha</span>
          <span>${cleanTime(prayerTimes.Isha)}</span>
        </div>

      `;
    }


    /*
     * ==========================================
     * CLEAN API TIME
     * ==========================================
     *
     * Some APIs can return values such as
     * "05:32 (+01)".
     */

    function cleanTime(time) {

      if (!time) {
        return "--:--";
      }

      return time.substring(0, 5);
    }


    /*
     * ==========================================
     * GET NEXT PRAYER
     * ==========================================
     */

    function getNextPrayer() {

      if (!prayerTimes || !prayerTimes.Fajr) {
        return null;
      }

      const now = new Date();

      const currentMinutes =
        now.getHours() * 60 +
        now.getMinutes() +
        now.getSeconds() / 60;

      const prayers = [

        {
          name: "Fajr",
          time: cleanTime(prayerTimes.Fajr)
        },

        {
          name: "Dhuhr",
          time: cleanTime(prayerTimes.Dhuhr)
        },

        {
          name: "Asr",
          time: cleanTime(prayerTimes.Asr)
        },

        {
          name: "Maghrib",
          time: cleanTime(prayerTimes.Maghrib)
        },

        {
          name: "Isha",
          time: cleanTime(prayerTimes.Isha)
        }

      ];

      for (const prayer of prayers) {

        if (!prayer.time) {
          continue;
        }

        const [hours, minutes] =
          prayer.time.split(":").map(Number);

        const totalMinutes =
          hours * 60 + minutes;

        if (totalMinutes > currentMinutes) {
          return prayer;
        }
      }

      // If all prayers have passed,
      // the next prayer is tomorrow's Fajr.
      return {
        name: "Fajr",
        time: cleanTime(prayerTimes.Fajr),
        tomorrow: true
      };
    }


    /*
     * ==========================================
     * COUNTDOWN
     * ==========================================
     */

    function updateCountdown() {

      const next = getNextPrayer();

      if (!next) {

        document.getElementById("countdown").innerText =
          "Waiting for prayer times...";

        return;
      }

      const now = new Date();

      const [hours, minutes] =
        next.time.split(":").map(Number);

      const target = new Date();

      target.setHours(hours);
      target.setMinutes(minutes);
      target.setSeconds(0);
      target.setMilliseconds(0);

      if (next.tomorrow || target <= now) {
        target.setDate(
          target.getDate() + 1
        );
      }

      const difference =
        target.getTime() - now.getTime();

      const totalSeconds =
        Math.floor(difference / 1000);

      const countdownHours =
        Math.floor(totalSeconds / 3600);

      const countdownMinutes =
        Math.floor((totalSeconds % 3600) / 60);

      const countdownSeconds =
        totalSeconds % 60;

      document.getElementById("countdown").innerText =
        `Next prayer: ${next.name} in ` +
        `${countdownHours}h ` +
        `${countdownMinutes}m ` +
        `${countdownSeconds}s`;
    }


    /*
     * ==========================================
     * NOTIFICATIONS
     * ==========================================
     */

    async function requestNotificationPermission() {

      if (!("Notification" in window)) {

        alert(
          "This browser does not support notifications."
        );

        return;
      }

      const permission =
        await Notification.requestPermission();

      if (permission === "granted") {

        document.getElementById("status").innerText =
          "🔔 Notifications enabled.";

      } else {

        document.getElementById("status").innerText =
          "Notifications were not enabled.";
      }
    }


    /*
     * ==========================================
     * SEND NOTIFICATION
     * ==========================================
     */

    function sendNotification(prayerName) {

      if (
        "Notification" in window &&
        Notification.permission === "granted"
      ) {

        new Notification("🕌 Prayer Time", {

          body:
            `Come pray ${prayerName}`,

          icon: ""
        });
      }
    }


    /*
     * ==========================================
     * CHECK PRAYER TIME
     * ==========================================
     */

    function checkPrayerTime() {

      if (!prayerTimes || !prayerTimes.Fajr) {
        return;
      }

      const now = new Date();

      const currentTime =
        now.getHours().toString().padStart(2, "0") +
        ":" +
        now.getMinutes().toString().padStart(2, "0");

      const prayers = [

        {
          name: "Fajr",
          time: cleanTime(prayerTimes.Fajr)
        },

        {
          name: "Dhuhr",
          time: cleanTime(prayerTimes.Dhuhr)
        },

        {
          name: "Asr",
          time: cleanTime(prayerTimes.Asr)
        },

        {
          name: "Maghrib",
          time: cleanTime(prayerTimes.Maghrib)
        },

        {
          name: "Isha",
          time: cleanTime(prayerTimes.Isha)
        }

      ];

      prayers.forEach(prayer => {

        if (
          prayer.time === currentTime &&
          lastTriggeredPrayer !==
          `${currentDate}-${prayer.name}`
        ) {

          // Remember that this prayer has already triggered.
          lastTriggeredPrayer =
            `${currentDate}-${prayer.name}`;

          // Show message.
          document.getElementById("message").innerText =
            `🕌 Come pray ${prayer.name}`;

          // Play audio.
          playPrayerAudio();

          // Send browser notification.
          sendNotification(prayer.name);
        }

      });
    }


    /*
     * ==========================================
     * PLAY PRAYER AUDIO
     * ==========================================
     */

    function playPrayerAudio() {

      const audio =
        document.getElementById("audio");

      audio.src = PRAYER_AUDIO;

      audio.currentTime = 0;

      const playPromise =
        audio.play();

      if (playPromise !== undefined) {

        playPromise.catch(error => {

          console.warn(
            "Audio could not autoplay. " +
            "The user may need to interact with the page first.",
            error
          );

          document.getElementById("status").innerText =
            "🔊 Tap the page/button once to allow prayer audio.";

        });
      }
    }


    /*
     * ==========================================
     * CHECK FOR NEW DAY
     * ==========================================
     */

    async function checkForNewDay() {

      const today = getDateString();

      if (today !== currentDate) {

        currentDate = today;

        lastTriggeredPrayer = null;

        await fetchPrayerTimes();

      }
    }


    /*
     * ==========================================
     * ERROR MESSAGE
     * ==========================================
     */

    function showError(message) {

      document.getElementById("status").innerHTML =
        `<span class="error">${message}</span>`;
    }


    /*
     * ==========================================
     * INITIALIZE
     * ==========================================
     */

    async function init() {

      updateDateTime();

      // Automatically detect location.
      getUserLocation();

      // Update clock every second.
      setInterval(updateDateTime, 1000);

      // Update countdown every second.
      setInterval(updateCountdown, 1000);

      // Check prayer time every 30 seconds.
      setInterval(checkPrayerTime, 30000);

      // Check whether a new day has started.
      setInterval(checkForNewDay, 30000);
    }


    /*
     * START WEBSITE
     * ==========================================
     */

    init();

  </script>

</body>
</html>
